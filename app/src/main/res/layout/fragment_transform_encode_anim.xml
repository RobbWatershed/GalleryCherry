<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_errors_queue"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    tools:context=".activities.TransformActivity">

    <me.devsaki.hentoid.views.ListPickerView
        android:id="@+id/encoder_anim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/encoder"
        tools:visibility="visible" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/encoder_anim_quality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/encoder_quality"
        android:visibility="gone"
        app:counterMaxLength="3"
        app:layout_constraintTop_toBottomOf="@id/encoder_anim"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoPersonalizedLearning"
            android:inputType="number"
            android:textCursorDrawable="@null" />

    </com.google.android.material.textfield.TextInputLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
