<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".activities.MetadataEditActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?android:attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/transform_menu"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/transform_media"
        tools:ignore="UnusedAttribute" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="Tabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tabIconTint="@color/selector_tab_icon"
        app:tabIndicatorColor="@color/white_opacity_87"
        app:tabIndicatorFullWidth="true"
        app:tabInlineLabel="true"
        app:tabSelectedTextColor="@color/white_opacity_87"
        app:tabTextColor="@color/white_opacity_25"
        tools:ignore="HardcodedText" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        app:layout_constraintTop_toBottomOf="@id/tabs" />

    <View
        android:id="@+id/divider"
        style="@style/Divider"
        android:layout_width="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/pager" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/skip_transformed_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:text="@string/transform_skip_transformed_pics"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/warnings_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:padding="8dp"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbars="vertical"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skip_transformed_switch"
        app:maxHeight="120dp"
        tools:layout_height="120dp"
        tools:listitem="@layout/item_drawer"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/preview_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/preview"
        android:textSize="@dimen/text_header_6"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/warnings_list"
        tools:ignore="ContentDescription" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/preview_progress"
        style="@style/Widget.Material3.LinearProgressIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/preview_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/preview_header"
        app:layout_constraintTop_toTopOf="@id/preview_header"
        tools:visibility="visible" />

    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/video_thumb_frame"
        android:layout_width="81dp"
        android:layout_height="108dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/img_thumb"
        app:layout_constraintEnd_toEndOf="@id/img_thumb"
        app:layout_constraintStart_toStartOf="@id/img_thumb"
        app:layout_constraintTop_toTopOf="@id/img_thumb"
        app:resize_mode="fit">

        <SurfaceView
            android:id="@+id/video_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            tools:ignore="ContentDescription" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <ImageView
        android:id="@+id/img_thumb"
        android:layout_width="81dp"
        android:layout_height="108dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:contentDescription="@string/picture_generic"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preview_header"
        tools:src="@drawable/ic_app"
        tools:tint="@color/medium_gray" />

    <TextView
        android:id="@+id/preview_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text=""
        android:textSize="@dimen/caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_thumb"
        app:layout_constraintTop_toTopOf="@id/img_thumb"
        tools:text="001.png ➤ 001.webp" />

    <TextView
        android:id="@+id/preview_dims"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="@dimen/caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_thumb"
        app:layout_constraintTop_toBottomOf="@id/preview_name"
        tools:text="1250x1800 ➤ 1250x1800" />

    <TextView
        android:id="@+id/preview_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="@dimen/caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_thumb"
        app:layout_constraintTop_toBottomOf="@id/preview_dims"
        tools:text="548 KB ➤ 450 KB" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/prev_page_btn"
        style="?attr/materialIconButtonFilledTonalStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:hint="@string/previous_page"
        android:tooltipText="@string/previous_page"
        app:icon="@drawable/ic_action_previous_item"
        app:layout_constraintBottom_toBottomOf="@id/img_thumb"
        app:layout_constraintEnd_toStartOf="@id/next_page_btn"
        app:layout_constraintStart_toEndOf="@id/img_thumb"
        tools:ignore="ContentDescription" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_page_btn"
        style="?attr/materialIconButtonFilledTonalStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:hint="@string/next_page"
        android:tooltipText="@string/next_page"
        app:icon="@drawable/ic_action_next_item"
        app:layout_constraintBottom_toBottomOf="@id/img_thumb"
        app:layout_constraintStart_toEndOf="@id/prev_page_btn"
        tools:ignore="ContentDescription" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_button"
        style="@style/Widget.Material3.Button.TonalButton.Icon"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/transform"
        app:icon="@drawable/ic_action_transform"
        app:layout_constraintTop_toBottomOf="@id/img_thumb" />

    <!-- Fullscreen previews that appears when tapping the thumb -->
    <FrameLayout
        android:id="@+id/fullscreen_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_opacity_50"
        android:visibility="gone" />

    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/video_fullscreen_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/img_fullscreen"
        app:layout_constraintEnd_toEndOf="@id/img_fullscreen"
        app:layout_constraintStart_toStartOf="@id/img_fullscreen"
        app:layout_constraintTop_toTopOf="@id/img_fullscreen"
        app:resize_mode="fit">

        <SurfaceView
            android:id="@+id/video_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            tools:ignore="ContentDescription" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <ImageView
        android:id="@+id/img_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/switch_fullscreen_btn"
        style="?attr/materialButtonTonalStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/transformed"
        android:text="@string/transformed"
        android:textSize="@dimen/caption"
        android:tooltipText="@string/transformed"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/preview_grp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:constraint_referenced_ids="next_page_btn, prev_page_btn, preview_size, preview_dims, preview_name, img_thumb, video_thumb_frame"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>